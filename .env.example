# Google Gemini API Key (aus https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Airtable Direktanbindung
AIRTABLE_API_KEY=pat_your_personal_access_token_here
AIRTABLE_BASE_ID=app_your_base_id_here
AIRTABLE_TABLE_NAME=Prijave (test)

# n8n Webhook URL (optional / parallel zu Airtable)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lina-recruiting

# FreeSWITCH / PBX Telefonie Konfiguration
PBX_TYPE=freeswitch
# IPv4-Adresse Ihres Servers (0.0.0.0 lauscht auf allen IPv4-Netzwerkkarten)
HOST=0.0.0.0
PORT=8000
# Audio-Abtastrate: FreeSWITCH nutzt standardmäßig 8000 Hz (oder 16000 Hz bei HD-Voice)
PBX_SAMPLE_RATE=8000

# Stimme für Lina (z. B. Aoede, Kore, Puck oder eigene Voice-Replication-ID)
VOICE_NAME=Aoede

# Anrufaufzeichnung (Call Recording in .wav und .txt)
ENABLE_CALL_RECORDING=true
RECORDINGS_DIR=recordings

# Logging, Debugging & Monitoring
LOGS_DIR=logs
DEBUG_MODE=false

# Langfuse Observability & Tracing (optional, aus https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# MCP Konfiguration (optional für spätere Tools)
MCP_CONFIG_PATH=mcp_servers.json
